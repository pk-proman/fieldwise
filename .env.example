# ---- required in production -------------------------------------------------
ENV=production
SECRET_KEY=              # python -c "import secrets;print(secrets.token_hex(32))"   (>= 32 chars; the app refuses to start otherwise)
POSTGRES_PASSWORD=       # a long random password
PUBLIC_URL=https://fieldwise.example.com     # used in emailed password-reset links
CORS_ORIGINS=capacitor://localhost,https://localhost,http://localhost   # the native app's origins (not your website)

# ---- optional ----------------------------------------------------------------
ALLOW_PRIVATE_URLS=0     # 1 only if ERPNext runs on a private network/VPN (metadata/loopback stay blocked)
PING_RETENTION_DAYS=180  # raw GPS breadcrumbs are deleted after this (minimum 30); per-workspace override in Settings
BIOMETRIC_PROVIDER=mock  # 'rekognition' for real face matching (needs boto3 + AWS credentials) - 'mock' accepts any selfie!
SMTP_HOST=               # platform fallback; each workspace can use its own mailbox in Settings
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMS_WEBHOOK_URL=         # platform fallback for visit OTP SMS; otherwise the OTP is shown on screen (demo mode)
