{
  "name": "fieldwise-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor shell that wraps the hosted Fieldwise web app and adds background GPS, mock-location detection and fingerprint unlock.",
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "sync": "node scripts/build-www.mjs && cap sync",
    "assets": "capacitor-assets generate --android --ios",
    "android": "cap open android",
    "ios": "cap open ios",
    "apk": "./scripts/build-apk.sh release"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "capacitor-native-biometric": "^4.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.0.0"
  }
}
